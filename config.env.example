# Profile paths are auto-detected on Windows, Linux, and macOS. Uncomment only
# to override the default. Windows example uses forward slashes intentionally.
# NIHONGO_ANKI_PROFILE="C:/Users/your-name/AppData/Roaming/Anki2/User 1"
# NIHONGO_ANKI_PROFILE="$HOME/.local/share/Anki2/User 1"
NIHONGO_ANKI_PROFILE_NAME="User 1"
NIHONGO_DECK_ROOT="日本語"

# The Anki executable is auto-detected in its standard location. Override only
# for a custom installation.
# NIHONGO_ANKI_COMMAND="C:/Users/your-name/AppData/Local/Programs/Anki/anki.exe"
# NIHONGO_ANKI_COMMAND="anki"
NIHONGO_ANKI_CONNECT_URL="http://127.0.0.1:8765"
NIHONGO_SYNC_TIMEOUT="300"
NIHONGO_CLOSE_ANKI_AFTER_SYNC="true"

# Optional: bypass AnkiConnect and run your own synchronous wrapper command.
# NIHONGO_SYNC_COMMAND="C:/Tools/sync-anki.cmd"

NIHONGO_GIT_REMOTE="origin"
NIHONGO_GIT_BRANCH="main"
