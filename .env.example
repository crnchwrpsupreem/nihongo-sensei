# Absolute path to the Anki profile folder on this machine.
# macOS default example:
# NIHONGO_ANKI_PROFILE="$HOME/Library/Application Support/Anki2/User 1"
# Linux default example:
# NIHONGO_ANKI_PROFILE="$HOME/.local/share/Anki2/User 1"

# Optional. Enables microphone transcription only; it is never sent to the browser.
# OPENAI_API_KEY=""

# Optional override; defaults to gpt-live-transcribe.
# NIHONGO_TRANSCRIBE_MODEL="gpt-live-transcribe"
